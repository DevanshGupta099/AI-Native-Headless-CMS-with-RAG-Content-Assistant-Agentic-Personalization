# ContentPilot AI - Environment Variables Example

# ==========================================
# Database Configuration (PostgreSQL + pgvector)
# ==========================================
DATABASE_URL="postgresql://contentpilot:contentpilot_dev@localhost:5432/contentpilot?schema=public"

# ==========================================
# Redis Configuration (Job Queue & Cache)
# ==========================================
REDIS_URL="redis://localhost:6379"

# ==========================================
# AI Provider Configuration (Free / Open-Source)
# ==========================================
# Primary LLM: Groq Cloud (Free Tier: 30 RPM, 14.4k req/day)
GROQ_API_KEY=""

# Primary Embeddings: HuggingFace Inference API (Free Tier)
HUGGINGFACE_API_KEY=""

# Provider Selectors: 'groq' | 'ollama' for LLM; 'huggingface' | 'ollama' for Embeddings
LLM_PROVIDER="groq"
EMBEDDING_PROVIDER="huggingface"

# Model Names
LLM_MODEL="llama-3.3-70b-versatile"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Local Ollama URL (Fallback)
OLLAMA_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3.2:3b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET="dev-super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRY="7d"

# ==========================================
# Application Ports & URLs
# ==========================================
BACKEND_PORT=3001
AUTHOR_STUDIO_PORT=3000
DELIVERY_SITE_PORT=3002
NODE_ENV="development"

# Next.js Public Endpoints
NEXT_PUBLIC_API_URL="http://localhost:3001"
