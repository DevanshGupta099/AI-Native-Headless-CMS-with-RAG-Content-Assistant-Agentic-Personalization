FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY pnpm-lock.yaml* pnpm-workspace.yaml turbo.json package.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/delivery-site/package.json ./apps/delivery-site/

RUN pnpm install

COPY packages/shared/ ./packages/shared/
COPY apps/delivery-site/ ./apps/delivery-site/

RUN pnpm --filter @contentpilot/shared build

EXPOSE 3002
CMD ["pnpm", "--filter", "@contentpilot/delivery-site", "dev"]
